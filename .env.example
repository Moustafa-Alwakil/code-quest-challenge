APP_NAME="Instructor Revenue Ledger"
APP_ENV=local
APP_KEY=
APP_DEBUG=true

# UTC end to end. Every period boundary is a true midnight UTC instant (R26),
# and a local-time app would split term_start from the capture it equals.
APP_TIMEZONE=UTC
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# MySQL 8+, never SQLite. The design leans on unique-violation behaviour,
# SELECT ... FOR UPDATE and MySQL transaction semantics; SQLite would quietly
# change the behaviour under test. See README § Why the tests need MySQL.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=code_quest
DB_USERNAME=root
DB_PASSWORD=

# The test database, created separately. phpunit.xml pins these values, so it
# has to exist under this name before the suite will run.
# DB_DATABASE_TESTING=code_quest_testing

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# Redis in anything resembling production: the payouts queue wants limited
# concurrency, and the schedule's withoutOverlapping/onOneServer guards need a
# shared cache. Both are optimizations — correctness survives without them
# (D-10) — but a database queue makes the failure demos slower to reproduce.
QUEUE_CONNECTION=redis
CACHE_STORE=redis

CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

#--------------------------------------------------------------------------
# Revenue policy (config/revenue.php)
#--------------------------------------------------------------------------
# Every dial below is a decision from docs/PLAN.md §4, not a tuning knob.
# The defaults are what the submission is built and demonstrated against;
# they are listed here so a reviewer can see the whole policy in one place.

# Single currency, integer minor units end to end (D-4).
REVENUE_CURRENCY=EGP

# Instructor pool share in basis points. 7000 = 70%. The pool is floored and
# the platform absorbs the sub-unit, so an instructor is never short-changed
# by an invisible remainder (D-4).
REVENUE_INSTRUCTOR_SHARE_BPS=7000

# Days an allocation stays held before it can be paid out (D-6).
REVENUE_HOLD_DAYS=7

# Balances below this carry forward rather than paying a provider fee to move
# small change (D-7).
REVENUE_MINIMUM_PAYOUT_MINOR=10000

# platform_retains | split_equally — what happens to a period with no
# engagement at all (D-3). Only platform_retains is implemented.
REVENUE_ZERO_ENGAGEMENT_POLICY=platform_retains

#--------------------------------------------------------------------------
# Payout provider (config/revenue.php)
#--------------------------------------------------------------------------
# random | mock | scripted. `scripted` expects a test to queue its outcomes,
# so it is for the suite, not for a running application.
PAYOUT_PROVIDER=random

# Outcome weights for the random mock, integers out of 100. Set one to 100 and
# the rest to 0 to make a recording deterministic without touching code —
# see docs/VIDEO.md.
PROVIDER_OUTCOME_SUCCESS=70
PROVIDER_OUTCOME_PERMANENT_FAILURE=10
PROVIDER_OUTCOME_TIMEOUT_AFTER_SUCCESS=10
PROVIDER_OUTCOME_DELAYED_CONFIRMATION=10

# Status checks a delayed_confirmation transfer stays pending for before it
# flips to success.
PROVIDER_CONFIRM_AFTER_CHECKS=2

#--------------------------------------------------------------------------
# Scale seeder sizing (config/scale.php)
#--------------------------------------------------------------------------
# Not policy — nothing about what a piastre is worth changes with these.
SCALE_SUBSCRIPTIONS=50000
SCALE_INSTRUCTORS=500
SCALE_STUDENTS=20000
SCALE_CHUNK=1000
