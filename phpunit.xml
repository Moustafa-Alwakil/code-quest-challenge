<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
        <!--
            Concurrency tests must not be transaction-wrapped (R11): a second
            connection cannot see the first's uncommitted rows, so the race
            under test never happens. These use DatabaseTruncation and run in
            the `concurrency` group, registered in tests/Pest.php.
        -->
        <!--
            The chaos test: a seeded random walk over the whole system, with
            every invariant asserted after every step. Its own suite because it
            is the slowest thing here and the most worth running alone.
        -->
        <testsuite name="Chaos">
            <directory>tests/Chaos</directory>
        </testsuite>
        <testsuite name="Concurrency">
            <directory>tests/Concurrency</directory>
        </testsuite>
    </testsuites>

    <!--
        The soak group is the same chaos walk at 5 000 steps rather than 300:
        ten minutes, not one. F11 budgets the default run in seconds, so it is
        excluded here, and asking for the soak group on the command line
        overrides this exclusion.
    -->
    <groups>
        <exclude>
            <group>soak</group>
        </exclude>
    </groups>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="CACHE_STORE" value="array"/>
       <env name="DB_CONNECTION" value="mysql"/>
        <env name="DB_HOST" value="127.0.0.1"/>
        <env name="DB_PORT" value="3306"/>
        <env name="DB_DATABASE" value="code_quest_testing"/>
        <env name="DB_USERNAME" value="root"/>
        <env name="DB_PASSWORD" value=""/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <!-- Deterministic provider outcomes: the suite scripts what it wants to happen. -->
        <env name="PAYOUT_PROVIDER" value="scripted"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <!-- Seeds property-based tests; override to replay a failing run exactly. -->
        <env name="TEST_SEED" value="20260923"/>
    </php>
</phpunit>
